[Unit]
Description=CCN Digital - remover registros temporários vencidos
After=postgresql.service

[Service]
Type=oneshot
User=ccn-digital
Group=ccn-digital
WorkingDirectory=/opt/ccn-digital/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/ccn-digital/ccn-digital.env
ExecStart=/usr/bin/node scripts/db-prune.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
